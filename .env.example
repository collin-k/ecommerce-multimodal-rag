# OpenAI-compatible API key (OpenAI, Groq, Together, etc.)
OPENAI_API_KEY=your_api_key_here

# Optional overrides
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
#
# To use an open-source LLM such as Llama 3.1 (course example), set
# OPENAI_BASE_URL to a Groq/Together/Ollama-compatible endpoint and
# LLM_MODEL to that provider's Llama model id.
